{
  "name": "fastart",
  "version": "1.0.0",
  "description": "FastArt - Powerful Cross-Platform AI-Powered Video Editor",
  "author": "FastArt Team",
  "license": "MIT",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.14",
    "@expo/vector-icons": "^15.0.2",
    "@types/react": "~19.3.0",
    "buffer": "^6.0.3",
    "expo": "~58.0.16",
    "expo-file-system": "~58.0.10",
    "expo-font": "~58.0.9",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-media-library": "~58.0.11",
    "expo-sharing": "~58.0.19",
    "expo-speech-recognition": "^58.0.0",
    "expo-splash-screen": "~58.0.10",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "expo-video": "~58.0.12",
    "expo-video-thumbnails": "~58.0.2",
    "jpeg-js": "^0.4.4",
    "pako": "^3.0.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-web": "^0.21.4",
    "typescript": "~6.0.3",
    "upng-js": "^2.1.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "npm run build:rust:android && expo run:android",
    "ios": "npm run build:rust:ios && expo run:ios",
    "web": "npm run build:wasm && expo start --web",
    "build:wasm": "cargo build --manifest-path rust/Cargo.toml --target wasm32-unknown-unknown --release --package fastart_wasm && mkdir -p assets/wasm && cp rust/target/wasm32-unknown-unknown/release/fastart_wasm.wasm assets/wasm/fastart_wasm.wasm",
    "build:rust": "cargo build --manifest-path rust/Cargo.toml --release",
    "build:rust:android": "cargo build --manifest-path rust/Cargo.toml --release --package fastart_jni",
    "build:rust:ios": "cargo build --manifest-path rust/Cargo.toml --release --package fastart_ios && mkdir -p modules/fastart-rust/ios && cp rust/target/release/libfastart_ios.a modules/fastart-rust/ios/libfastart_ios.a",
    "test:rust": "cargo test --manifest-path rust/Cargo.toml",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint"
  },
  "private": true
}
